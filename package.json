{
  "name": "hys-ui-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:docs": "vite --config apps/docs/vite.config.ts",
    "build:ui": "node scripts/generate-exports.mjs && npm run build --workspace hys-ui",
    "build:docs": "npm run build:ui && node scripts/generate-api.mjs && vue-tsc --noEmit -p apps/docs/tsconfig.json && vite build --config apps/docs/vite.config.ts",
    "build:docs:pages": "npm run build:docs && node scripts/prepare-docs-pages.mjs",
    "typecheck": "vue-tsc --noEmit -p packages/ui/tsconfig.json && vue-tsc --noEmit -p apps/docs/tsconfig.json",
    "check:contracts": "node scripts/check-contracts.mjs",
    "check:release": "npm run build:docs && npm test && npm run check:contracts && node scripts/pack.mjs && npm run test:consumer",
    "check:features": "npm run pack:features && node scripts/test-feature-packages.mjs",
    "pack:features": "npm run build:ui && node scripts/pack-feature-packages.mjs",
    "pack:ui": "npm run build:ui && node scripts/pack.mjs",
    "release:ui": "node scripts/release.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:consumer": "node scripts/test-consumer.mjs",
    "docs:api": "node scripts/generate-api.mjs",
    "docs:scaffold": "node scripts/generate-api.mjs && node scripts/scaffold-examples.mjs && node scripts/clean-example-sources.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/compiler-sfc": "^3.5.13",
    "jsdom": "^26.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.10",
    "shiki": "^4.6.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.5",
    "vue-component-meta": "3.3.14",
    "vue-tsc": "^3.3.14"
  }
}
