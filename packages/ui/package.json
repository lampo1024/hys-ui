{
  "name": "hys-ui",
  "version": "0.8.0",
  "description": "Themeable Vue 3 components with TypeScript and interactive documentation",
  "type": "module",
  "license": "MIT",
  "author": "hys-ui contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lampo1024/hys-ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/lampo1024/hys-ui#readme",
  "bugs": "https://github.com/lampo1024/hys-ui/issues",
  "keywords": [
    "vue",
    "vue3",
    "components",
    "typescript",
    "hys-ui"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./pro-grid.css": "./dist/pro-grid.css",
    "./pro-grid/conditional-format": {
      "types": "./dist/types/components/HysProGrid/conditionalFormat.d.ts",
      "import": "./dist/pro-grid/conditional-format.js"
    },
    "./pro-grid/conditional-format.css": "./dist/pro-grid/conditional-format.css",
    "./pro-grid/clipboard": {
      "types": "./dist/types/components/HysProGrid/clipboard/clipboard.d.ts",
      "import": "./dist/pro-grid/clipboard.js"
    },
    "./pro-grid/clipboard.css": "./dist/pro-grid/clipboard.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "vue": ">=3.5.0 <4"
  },
  "dependencies": {
    "async-validator": "^4.2.5",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "lucide-vue-next": "^0.468.0",
    "pinyin-pro": "^3.29.5",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "vue": "^3.5.13"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build --config vite.config.ts && node scripts/copy-optional-styles.mjs && vue-tsc -p tsconfig.build.json"
  }
}
